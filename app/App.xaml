<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Rinflow.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rinflow">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SvgImageSource x:Key="AppLogo" UriSource="ms-appx:///Assets/Rinflow.svg" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SvgImageSource x:Key="AppLogo" UriSource="ms-appx:///Assets/Rinflow.Dark.svg" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Switches end at their track: the template reserves this much
                 width for the on / off text, which these switches show on
                 their left instead (SwitchStateStyle). -->
            <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>

            <!-- A card: one settings row, a device row, the sharing switch.
                 Like Windows Settings, a little denser: 16 epx side padding,
                 56 epx rows, the in-page corner radius (4), cards 4 epx apart. -->
            <Style x:Key="CardStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>

            <!-- The type ramp's Title (28 / 36, Semibold). -->
            <Style x:Key="PageTitleStyle" BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="TextBlock" />

            <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,20,0,8" />
            </Style>

            <Style x:Key="RowTitleStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="RowDescriptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- The 开 / 关 next to a switch. The switch's own content would
                 sit on its right; Windows Settings shows it on the left. -->
            <Style x:Key="SwitchStateStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>

            <Style x:Key="BareSwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,-12,0" />
            </Style>

            <!-- Icon buttons: the standard control height, 32 epx. -->
            <Style x:Key="IconButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="SubtleIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>

            <!-- A key of a shortcut, drawn as a keycap. -->
            <Style x:Key="KeycapStyle" TargetType="Border">
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
