<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LinkCursor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkCursor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LinkCursor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Grid">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>
            <Style x:Key="SliderValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="LinkCursor" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="680" Padding="32,8,32,32" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="DeviceNameText"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="LinkCursor" />
                    <TextBlock
                        x:Name="StatusText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="正在连接后台服务…" />
                </StackPanel>

                <SelectorBar x:Name="Sections" Margin="-12,0,0,0">
                    <SelectorBarItem x:Name="DevicesItem" IsSelected="True" Text="设备" />
                    <SelectorBarItem x:Name="EffectItem" Text="连接效果" />
                </SelectorBar>

                <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Warning" />

                <!-- Devices -->
                <StackPanel x:Name="DevicesPanel" Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="附近的设备" />
                    <ListView
                        x:Name="PeerList"
                        ItemsSource="{x:Bind Peers}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PeerItem">
                                <Grid
                                    Padding="16,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ColumnSpacing="16"
                                    CornerRadius="{StaticResource OverlayCornerRadius}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Glyph="&#xE7F4;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Detail}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        Click="OnPeerAction"
                                        Content="{x:Bind ActionText}"
                                        IsEnabled="{x:Bind CanAct}"
                                        Tag="{x:Bind Id}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="EmptyText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="正在查找同一网络中运行 LinkCursor 的设备…"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Edge push-through effect -->
                <StackPanel x:Name="EffectPanel" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="16" Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="效果演示" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="开启后，把鼠标推向屏幕右边缘：边缘会鼓起，推够距离后光标从左边缘出现，就像进入了右侧的另一台设备；再往左推即可回来。关闭本窗口时自动停止。"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="DemoSideText"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="DemoToggle"
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="PreviewButton"
                            Content="播放预览"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="ResetEffectButton" Content="恢复默认" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="手感" />
                    <Grid Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="推动距离" ToolTipService.ToolTip="第一次穿过边缘前需要推动的鼠标原始计数，越大阻力越强" />
                                <TextBlock x:Name="PushDistanceValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="PushDistanceSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="800" Minimum="40" StepFrequency="10" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="停推后回弹" ToolTipService.ToolTip="停止推动多久后鼓包缩回" />
                                <TextBlock x:Name="ReleaseDelayValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="ReleaseDelaySlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Minimum="0" StepFrequency="0.05" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="连续切换免阻力" ToolTipService.ToolTip="穿过一次后，这段时间内再次穿过不需要推" />
                                <TextBlock x:Name="WarmSecondsValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="WarmSecondsSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="60" Minimum="0" StepFrequency="1" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="角落死区" ToolTipService.ToolTip="屏幕角落附近不触发，避免影响开始按钮和菜单" />
                                <TextBlock x:Name="CornerDeadZoneValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="CornerDeadZoneSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="200" Minimum="0" StepFrequency="4" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="动画" />
                    <Grid Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="弹簧响应" ToolTipService.ToolTip="动画到位所需的大致时间，越小越干脆" />
                                <TextBlock x:Name="SpringResponseValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="SpringResponseSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="0.8" Minimum="0.1" StepFrequency="0.01" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="阻尼比" ToolTipService.ToolTip="1 为不回弹，越小回弹晃动越明显" />
                                <TextBlock x:Name="SpringDampingValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="SpringDampingSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Minimum="0.3" StepFrequency="0.01" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="外观" />
                    <Grid Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="鼓包高度" />
                                <TextBlock x:Name="BumpDepthValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="BumpDepthSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="60" Minimum="8" StepFrequency="1" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="鼓包宽度" />
                                <TextBlock x:Name="BumpWidthValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="BumpWidthSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="160" Minimum="30" StepFrequency="2" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="光点大小" />
                                <TextBlock x:Name="DotSizeValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="DotSizeSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="40" Minimum="0" StepFrequency="1" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="不透明度" />
                                <TextBlock x:Name="OpacityValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Minimum="0.3" StepFrequency="0.01" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="穿过时的涟漪" />
                                <ToggleSwitch
                                    x:Name="RippleToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="颜色" />
                                <ComboBox x:Name="ThemeCombo" Grid.Column="1" MinWidth="140">
                                    <ComboBoxItem Content="跟随系统" Tag="auto" />
                                    <ComboBoxItem Content="浅色" Tag="light" />
                                    <ComboBoxItem Content="深色" Tag="dark" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
