<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LinkCursor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkCursor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LinkCursor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Grid">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>
            <Style x:Key="SliderValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="LinkCursor" />
        </Grid>

        <!-- ScrollView with vertical content: the page is laid out at the
             viewport's width. A ScrollViewer would centre a page narrower
             than the viewport by its desired width (the Devices tab's
             content can be short) and push the 680-wide column off-centre. -->
        <ScrollView Grid.Row="1" ContentOrientation="Vertical">
            <StackPanel MaxWidth="680" Padding="32,8,32,32" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="DeviceNameText"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="LinkCursor" />
                    <TextBlock
                        x:Name="StatusText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="正在连接后台服务…" />
                </StackPanel>

                <SelectorBar x:Name="Sections" Margin="-12,0,0,0">
                    <SelectorBarItem x:Name="DevicesItem" IsSelected="True" Text="设备" />
                    <SelectorBarItem x:Name="ArrangementItem" Text="排列" />
                    <SelectorBarItem x:Name="EffectItem" Text="连接效果" />
                </SelectorBar>

                <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Warning" />

                <!-- Devices -->
                <StackPanel x:Name="DevicesPanel" Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="附近的设备" />
                    <!-- A plain ItemsControl: nothing is selected, and a ListView
                         would nest its own scroller inside the page's. -->
                    <ItemsControl x:Name="PeerList" ItemsSource="{x:Bind Peers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PeerItem">
                                <Grid
                                    Padding="16,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ColumnSpacing="16"
                                    CornerRadius="{StaticResource OverlayCornerRadius}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Glyph="&#xE7F4;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Detail}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <DropDownButton Content="位置" ToolTipService.ToolTip="把这台设备放在这台电脑的某一侧">
                                            <DropDownButton.Flyout>
                                                <MenuFlyout Placement="Bottom">
                                                    <MenuFlyoutItem Click="OnPlaceLeft" Tag="{x:Bind Id}" Text="放在左边" />
                                                    <MenuFlyoutItem Click="OnPlaceRight" Tag="{x:Bind Id}" Text="放在右边" />
                                                    <MenuFlyoutItem Click="OnPlaceTop" Tag="{x:Bind Id}" Text="放在上边" />
                                                    <MenuFlyoutItem Click="OnPlaceBottom" Tag="{x:Bind Id}" Text="放在下边" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Click="OnRemovePlacement" Tag="{x:Bind Id}" Text="不放置" />
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <Button
                                            Click="OnPeerAction"
                                            Content="{x:Bind ActionText}"
                                            IsEnabled="{x:Bind CanAct}"
                                            Tag="{x:Bind Id}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        x:Name="EmptyText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="正在查找同一网络中运行 LinkCursor 的设备…"
                        TextWrapping="Wrap" />

                    <Grid
                        Margin="0,12,0,0"
                        ColumnSpacing="16"
                        Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="同步剪贴板" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="控制权移到另一台设备时，剪贴板跟着过去：文字、网页格式和图片，最大 8 MB。密码管理器标记为隐私的内容不会同步。目前传输还没有加密，请只在可信的网络中开启。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ClipboardToggle"
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </StackPanel>

                <!-- Arrangement: where each device sits around this PC -->
                <StackPanel x:Name="ArrangementPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="把设备拖到这台电脑的屏幕旁边：放在哪一侧、和哪一段边对齐，鼠标就从那一段穿过去。连接时会自动同步给对方。"
                        TextWrapping="Wrap" />
                    <Grid
                        x:Name="ArrangementHost"
                        Height="340"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Canvas x:Name="ArrangementCanvas" Background="Transparent" />
                    </Grid>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="未放置的设备" />
                    <StackPanel x:Name="UnplacedPanel" Orientation="Horizontal" Spacing="8" />
                    <TextBlock
                        x:Name="UnplacedHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="同一网络中发现的设备会出现在这里，把它拖到上面屏幕的旁边。把已放置的设备拖回这里可以取消放置。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Edge push-through effect -->
                <StackPanel x:Name="EffectPanel" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="16" Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="效果演示" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="开启后，把鼠标推向“排列”里放置了设备的那段屏幕边缘（还没有放置设备时用右边缘）：边缘会鼓起，推够距离后光标从对边出现，就像进入了那台设备；再往回推即可回来。关闭本窗口时自动停止。"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="DemoSideText"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="DemoToggle"
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="PreviewButton"
                            Content="播放预览"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="ResetEffectButton" Content="恢复默认" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="手感" />
                    <Grid Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="推动距离" ToolTipService.ToolTip="第一次穿过边缘前需要推动的鼠标原始计数，越大阻力越强" />
                                <TextBlock x:Name="PushDistanceValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="PushDistanceSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="800" Minimum="40" StepFrequency="10" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="停推后回弹" ToolTipService.ToolTip="停止推动多久后鼓包缩回" />
                                <TextBlock x:Name="ReleaseDelayValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="ReleaseDelaySlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Minimum="0" StepFrequency="0.05" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="连续切换免阻力" ToolTipService.ToolTip="穿过一次后，这段时间内再次穿过不需要推" />
                                <TextBlock x:Name="WarmSecondsValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="WarmSecondsSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="60" Minimum="0" StepFrequency="1" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="角落死区" ToolTipService.ToolTip="屏幕角落附近不触发，避免影响开始按钮和菜单" />
                                <TextBlock x:Name="CornerDeadZoneValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="CornerDeadZoneSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="200" Minimum="0" StepFrequency="4" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="动画" />
                    <Grid Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="弹簧响应" ToolTipService.ToolTip="动画到位所需的大致时间，越小越干脆" />
                                <TextBlock x:Name="SpringResponseValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="SpringResponseSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="0.8" Minimum="0.1" StepFrequency="0.01" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="阻尼比" ToolTipService.ToolTip="1 为不回弹，越小回弹晃动越明显" />
                                <TextBlock x:Name="SpringDampingValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="SpringDampingSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Minimum="0.3" StepFrequency="0.01" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="外观" />
                    <Grid Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="鼓包高度" />
                                <TextBlock x:Name="BumpDepthValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="BumpDepthSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="60" Minimum="8" StepFrequency="1" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="鼓包宽度" />
                                <TextBlock x:Name="BumpWidthValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="BumpWidthSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="160" Minimum="30" StepFrequency="2" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="光点大小" />
                                <TextBlock x:Name="DotSizeValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="DotSizeSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="40" Minimum="0" StepFrequency="1" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="不透明度" />
                                <TextBlock x:Name="OpacityValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Minimum="0.3" StepFrequency="0.01" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="穿过时的涟漪" />
                                <ToggleSwitch
                                    x:Name="RippleToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="颜色" />
                                <ComboBox x:Name="ThemeCombo" Grid.Column="1" MinWidth="140">
                                    <ComboBoxItem Content="跟随系统" Tag="auto" />
                                    <ComboBoxItem Content="浅色" Tag="light" />
                                    <ComboBoxItem Content="深色" Tag="dark" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollView>
    </Grid>
</Window>
