<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rinflow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rinflow"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Rinflow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="SliderValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <!-- Screens on the arrangement canvas. Built from templates so
                 their ThemeResource colours follow the window's theme. -->
            <DataTemplate x:Key="LocalScreenTemplate">
                <Grid>
                    <Border
                        x:Name="Shape"
                        Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="4" />
                    <StackPanel
                        x:Name="Labels"
                        Padding="6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <FontIcon
                            x:Name="Icon"
                            Margin="0,0,0,8"
                            FontSize="20"
                            Glyph="&#xE7F4;" />
                        <TextBlock
                            x:Name="Title"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="Subtitle"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="PeerScreenTemplate">
                <Grid>
                    <Border
                        x:Name="Shape"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                    <StackPanel
                        x:Name="Labels"
                        Padding="6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <FontIcon
                            x:Name="Icon"
                            Margin="0,0,0,8"
                            FontSize="20"
                            Glyph="&#xE7F4;" />
                        <TextBlock
                            x:Name="Title"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="Subtitle"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ChipTemplate">
                <Border
                    Padding="12,5"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="Icon" FontSize="14" />
                        <TextBlock x:Name="Title" />
                    </StackPanel>
                </Border>
            </DataTemplate>
            <!-- Where a dragged device will land. -->
            <DataTemplate x:Key="PreviewScreenTemplate">
                <Grid IsHitTestVisible="False">
                    <Rectangle
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.14"
                        RadiusX="4"
                        RadiusY="4" />
                    <Rectangle
                        RadiusX="4"
                        RadiusY="4"
                        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                        StrokeDashArray="4,3"
                        StrokeThickness="2" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="DotsTemplate">
                <Path Fill="{ThemeResource ControlStrongStrokeColorDisabledBrush}" />
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar. The back button sits outside the drag region so it
             can be clicked. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                x:Uid="BackButton" AutomationProperties.Name="返回"
                Style="{StaticResource SubtleIconButtonStyle}"
                ToolTipService.ToolTip="返回"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <Grid
                x:Name="AppTitleBar"
                Grid.Column="1"
                Padding="16,0,0,0"
                Background="Transparent"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- 16 x 16, as Windows 11 title bars, close to the title. -->
                <Image Width="16" Height="16" VerticalAlignment="Center" Stretch="Uniform" Source="{ThemeResource AppLogo}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Rinflow" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Above every page, not on the devices page alone: most
                 requests that can fail are made on the settings page. Code
                 collapses a closed bar, so its margin takes no room. -->
            <StackPanel MaxWidth="1040" Padding="28,0,28,0">
                <!-- The background service could not be started
                     (AgentClient's problems); its text comes from code. -->
                <InfoBar
                    x:Name="AgentBar"
                    Margin="0,0,0,8"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error">
                    <InfoBar.ActionButton>
                        <Button x:Name="AgentRetryButton" x:Uid="AgentRetryButton" Content="重试" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    x:Name="ErrorBar"
                    Margin="0,0,0,8"
                    IsOpen="False"
                    Severity="Warning" />
            </StackPanel>

            <!-- ================= Devices ================= -->
            <!-- ScrollView with vertical content: the page is laid out at the
                 viewport's width (a ScrollViewer would centre a narrower page
                 by its desired width). -->
            <ScrollView x:Name="DevicesPage" Grid.Row="1" ContentOrientation="Vertical">
                <StackPanel MaxWidth="1040" Padding="28,8,28,24">
                    <!-- 40 below: as it was with the two bars that are now
                         above the pages. -->
                    <Grid Margin="0,0,0,40" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource PageTitleStyle}"
                            x:Uid="DevicesTitle" Text="设备" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <Button
                                x:Name="AddDeviceButton"
                                x:Uid="AddDeviceButton" AutomationProperties.Name="添加设备"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock x:Uid="AddDeviceLabel" Text="添加设备" />
                                </StackPanel>
                            </Button>
                            <!-- The edge animation's tuning page: only in
                                 builds with EffectDemo (docs/building.md). -->
                            <Button
                                x:Name="EffectButton"
                                AutomationProperties.Name="动画效果（开发版）"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="动画效果（仅开发版）"
                                Visibility="Collapsed">
                                <FontIcon FontSize="16" Glyph="&#xE9E9;" />
                            </Button>
                            <Button
                                x:Name="SettingsButton"
                                x:Uid="SettingsButton" AutomationProperties.Name="设置"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="设置">
                                <FontIcon FontSize="16" Glyph="&#xE713;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <InfoBar
                        x:Name="LockBar"
                        Margin="0,0,0,12"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Informational"
                        x:Uid="LockBar" Title="已锁定到当前屏幕" />

                    <!-- Sharing on / off -->
                    <Grid Height="56" Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE962;" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource RowTitleStyle}"
                            x:Uid="SharingTitle" Text="共享键盘和鼠标" />
                        <TextBlock x:Name="SharingState" Grid.Column="2" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch
                            x:Name="SharingToggle"
                            Grid.Column="3"
                            x:Uid="SharingToggle" AutomationProperties.Name="共享键盘和鼠标"
                            Style="{StaticResource BareSwitchStyle}" />
                    </Grid>

                    <!-- Files on their way (built in code, MainWindow.Transfers.cpp). -->
                    <StackPanel
                        x:Name="TransfersPanel"
                        Margin="0,4,0,0"
                        Spacing="4"
                        Visibility="Collapsed" />

                    <!-- Arrangement -->
                    <Grid
                        x:Name="ArrangementHost"
                        Height="320"
                        Margin="0,12,0,0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <Canvas x:Name="DotsCanvas" IsHitTestVisible="False" />
                        <!-- The strip under the canvas, as on macOS: devices not
                             placed yet, and where a placed one is dropped to
                             unplace it. Below the canvas, so a dragged device
                             stays visible over it; its height is StripHeight. -->
                        <Border
                            Height="40"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,4,4"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="StripHighlight"
                            Height="40"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="0,0,4,4"
                            IsHitTestVisible="False"
                            Opacity="0.18"
                            Visibility="Collapsed" />
                        <Canvas x:Name="ArrangementCanvas" Background="Transparent" />
                        <StackPanel
                            Height="40"
                            Margin="10,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal"
                            Spacing="8">
                            <StackPanel
                                x:Name="UnplacedChips"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8" />
                            <TextBlock
                                x:Name="StripHint"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsHitTestVisible="False" />
                        </StackPanel>
                    </Grid>

                    <!-- The user's devices -->
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="MyDevicesHeader" Text="我的设备" />
                    <!-- A plain ItemsControl: nothing is selected, and a ListView
                         would nest its own scroller inside the page's. -->
                    <ItemsControl ItemsSource="{x:Bind Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PeerItem">
                                <Grid Style="{StaticResource CardStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Statuses line up; a longer one (等待配对确认…) widens its row's column. -->
                                        <ColumnDefinition Width="Auto" MinWidth="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Glyph="{x:Bind Glyph}"
                                        Opacity="{x:Bind ContentOpacity}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Opacity="{x:Bind ContentOpacity}"
                                        Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Detail}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Latency, Mode=OneWay}"
                                        Visibility="{x:Bind LatencyVisibility, Mode=OneWay}" />
                                    <HyperlinkButton
                                        Grid.Column="2"
                                        x:Uid="RowConnect"
                                        VerticalAlignment="Center"
                                        Click="OnConnectDevice"
                                        Content="连接"
                                        Tag="{x:Bind Id}"
                                        Visibility="{x:Bind ConnectVisibility}" />
                                    <StackPanel
                                        Grid.Column="3"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Grid VerticalAlignment="Center">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="{x:Bind ConnectedVisibility}" />
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                                StrokeThickness="1.5"
                                                Visibility="{x:Bind OtherVisibility}" />
                                        </Grid>
                                        <Grid>
                                            <TextBlock
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Text="{x:Bind StatusText}"
                                                Visibility="{x:Bind ConnectedVisibility}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind StatusText}"
                                                Visibility="{x:Bind OtherVisibility}" />
                                        </Grid>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        x:Uid="RowMore" AutomationProperties.Name="更多操作"
                                        Click="OnDeviceMore"
                                        Style="{StaticResource SubtleIconButtonStyle}"
                                        Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="更多操作">
                                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        x:Name="DevicesEmptyText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        x:Uid="DevicesEmpty" Text="还没有设备。点“添加设备”连接同一网络中运行 Rinflow 的电脑；从其他设备连过来的也会出现在这里。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollView>

            <!-- ================= Settings ================= -->
            <ScrollView
                x:Name="SettingsPage"
                Grid.Row="1"
                ContentOrientation="Vertical"
                Visibility="Collapsed">
                <StackPanel MaxWidth="1040" Padding="28,8,28,24" Spacing="4">
                    <TextBlock Style="{StaticResource PageTitleStyle}" x:Uid="SettingsTitle" Text="设置" />

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="GeneralHeader" Text="常规" />
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="LaunchTitle" Text="开机时启动" />
                        <TextBlock x:Name="LaunchState" Grid.Column="1" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="LaunchToggle" Grid.Column="2" x:Uid="LaunchToggle" AutomationProperties.Name="开机时启动" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="TrayTitle" Text="关闭窗口时保留在托盘" />
                            <TextBlock Style="{StaticResource RowDescriptionStyle}" x:Uid="TrayDescription" Text="关闭后，关掉窗口会同时退出 Rinflow，键鼠共享也随之停止。" />
                        </StackPanel>
                        <TextBlock x:Name="TrayState" Grid.Column="1" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="TrayToggle" Grid.Column="2" x:Uid="TrayToggle" AutomationProperties.Name="关闭窗口时保留在托盘" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="ThemeTitle" Text="主题" />
                        <ComboBox
                            x:Name="ThemeCombo"
                            Grid.Column="1"
                            MinWidth="200"
                            VerticalAlignment="Center"
                            x:Uid="ThemeCombo" AutomationProperties.Name="主题">
                            <ComboBoxItem x:Uid="ThemeSystem" Content="跟随系统" Tag="system" />
                            <ComboBoxItem x:Uid="ThemeLight" Content="浅色" Tag="light" />
                            <ComboBoxItem x:Uid="ThemeDark" Content="深色" Tag="dark" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="LanguageTitle" Style="{StaticResource RowTitleStyle}" Text="语言" />
                            <TextBlock x:Uid="LanguageDescription" Style="{StaticResource RowDescriptionStyle}" Text="更改后 Rinflow 窗口会重新打开。" />
                        </StackPanel>
                        <!-- Language names stay in their own language. -->
                        <ComboBox
                            x:Name="LanguageCombo"
                            x:Uid="LanguageCombo"
                            Grid.Column="1"
                            MinWidth="200"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="语言">
                            <ComboBoxItem x:Uid="LanguageSystem" Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                            <ComboBoxItem Content="English" Tag="en-US" />
                            <ComboBoxItem Content="日本語" Tag="ja-JP" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="SwitchingHeader" Text="屏幕切换" />
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="DelayTitle" Text="切换延迟" />
                            <TextBlock Style="{StaticResource RowDescriptionStyle}" x:Uid="DelayDescription" Text="光标要在屏幕边缘推住这么久才会切换到另一台设备。" />
                        </StackPanel>
                        <Slider
                            x:Name="SwitchDelaySlider"
                            Grid.Column="1"
                            Width="240"
                            VerticalAlignment="Center"
                            x:Uid="DelaySlider" AutomationProperties.Name="切换延迟"
                            Maximum="500"
                            Minimum="0"
                            StepFrequency="10" />
                        <TextBlock
                            x:Name="SwitchDelayValue"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="CornerTitle" Text="屏幕角落不触发切换" />
                            <TextBlock Style="{StaticResource RowDescriptionStyle}" x:Uid="CornerDescription" Text="让开始按钮、菜单和触发角保持好用。" />
                        </StackPanel>
                        <TextBlock x:Name="CornerState" Grid.Column="1" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="CornerToggle" Grid.Column="2" x:Uid="CornerToggle" AutomationProperties.Name="屏幕角落不触发切换" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="FullscreenTitle" Text="全屏游戏时暂停" />
                            <TextBlock Style="{StaticResource RowDescriptionStyle}" x:Uid="FullscreenDescription" Text="全屏运行游戏、视频或演示时，光标不会切换到其他设备。" />
                        </StackPanel>
                        <TextBlock x:Name="FullscreenState" Grid.Column="1" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="FullscreenToggle" Grid.Column="2" x:Uid="FullscreenToggle" AutomationProperties.Name="全屏游戏时暂停" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="LockTitle" Text="锁定到当前屏幕" />
                            <TextBlock Style="{StaticResource RowDescriptionStyle}" x:Uid="LockDescription" Text="按一次快捷键，光标留在当前屏幕上不再切换；再按一次解除。" />
                        </StackPanel>
                        <StackPanel
                            x:Name="HotkeyKeys"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6" />
                        <Button
                            x:Name="EditHotkeyButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            x:Uid="EditHotkeyButton" AutomationProperties.Name="修改快捷键"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            ToolTipService.ToolTip="修改快捷键">
                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        </Button>
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="SwitchHotkeysTitle" Style="{StaticResource RowTitleStyle}" Text="用快捷键切换设备" />
                            <TextBlock x:Uid="SwitchHotkeysDescription" Style="{StaticResource RowDescriptionStyle}" Text="按所选组合键加方向键，光标直接移到那一侧的设备。其他程序就收不到这组快捷键了。" />
                            <TextBlock
                                x:Name="SwitchHotkeysWarning"
                                x:Uid="SwitchHotkeysWarning"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource RowDescriptionStyle}"
                                Text="有的组合已被其他程序占用，那几个方向用不了。换一组试试。"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <!-- RegisterHotKey modifier bits: Ctrl 2, Alt 1, Shift 4. -->
                        <ComboBox
                            x:Name="SwitchModifiersCombo"
                            x:Uid="SwitchModifiersCombo"
                            Grid.Column="1"
                            MinWidth="200"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="切换设备的组合键">
                            <ComboBoxItem Content="Ctrl+Alt+Shift+↑↓←→" Tag="7" />
                            <ComboBoxItem Content="Ctrl+Alt+↑↓←→" Tag="3" />
                        </ComboBox>
                        <TextBlock x:Name="SwitchHotkeysState" Grid.Column="2" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="SwitchHotkeysToggle" x:Uid="SwitchHotkeysToggle" Grid.Column="3" AutomationProperties.Name="用快捷键切换设备" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>
                    <!-- What a Mac's modifier keys play as while it controls
                         this PC: a preset, or a choice per key (the custom
                         card below; MainWindow.Settings.cpp fills it). -->
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="ModifierMapTitle" Style="{StaticResource RowTitleStyle}" Text="Mac 控制本机时的修饰键" />
                            <TextBlock x:Name="ModifierMapDescription" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ModifierPresetCombo"
                            x:Uid="ModifierPresetCombo"
                            Grid.Column="1"
                            MinWidth="200"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Mac 控制本机时的修饰键">
                            <ComboBoxItem x:Uid="ModifierPresetMac" Content="Mac 习惯（推荐）" Tag="mac" />
                            <ComboBoxItem x:Uid="ModifierPresetKeep" Content="保持键位" Tag="keep" />
                            <ComboBoxItem x:Uid="ModifierPresetCustom" Content="自定义" Tag="custom" />
                        </ComboBox>
                    </Grid>
                    <Grid
                        x:Name="ModifierCustomPanel"
                        RowSpacing="8"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="⌘ Command" />
                        <ComboBox x:Name="ModifierSuperCombo" Grid.Column="1" MinWidth="200" AutomationProperties.Name="⌘ Command" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="⌃ Control" />
                        <ComboBox x:Name="ModifierControlCombo" Grid.Row="1" Grid.Column="1" MinWidth="200" AutomationProperties.Name="⌃ Control" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="⌥ Option" />
                        <ComboBox x:Name="ModifierAltCombo" Grid.Row="2" Grid.Column="1" MinWidth="200" AutomationProperties.Name="⌥ Option" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="HideCursorTitle" Style="{StaticResource RowTitleStyle}" Text="其他设备离开后隐藏光标" />
                            <TextBlock x:Uid="HideCursorDescription" Style="{StaticResource RowDescriptionStyle}" Text="其他设备控制完这台电脑、光标移走后，这里的光标先藏起来；动一下这台电脑的鼠标或触摸板就会出现。" />
                        </StackPanel>
                        <TextBlock x:Name="HideCursorState" Grid.Column="1" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="HideCursorToggle" x:Uid="HideCursorToggle" Grid.Column="2" AutomationProperties.Name="其他设备离开后隐藏光标" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>

                    <TextBlock x:Uid="PresenceHeader" Style="{StaticResource SectionHeaderStyle}" Text="锁屏与唤醒" />
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="KeepAwakeTitle" Style="{StaticResource RowTitleStyle}" Text="在其他设备上工作时保持唤醒" />
                            <TextBlock x:Uid="KeepAwakeDescription" Style="{StaticResource RowDescriptionStyle}" Text="你在已连接的其他设备上操作时，这台电脑不熄屏，也不会因闲置而锁定。" />
                        </StackPanel>
                        <TextBlock x:Name="KeepAwakeState" Grid.Column="1" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="KeepAwakeToggle" x:Uid="KeepAwakeToggle" Grid.Column="2" AutomationProperties.Name="在其他设备上工作时保持唤醒" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="LockSyncTitle" Style="{StaticResource RowTitleStyle}" Text="一起锁定" />
                            <TextBlock x:Uid="LockSyncDescription" Style="{StaticResource RowDescriptionStyle}" Text="锁定这台电脑时，已连接的设备一起锁定；它们锁定时，这台电脑也锁定。两台设备都打开此项才生效。" />
                        </StackPanel>
                        <TextBlock x:Name="LockSyncState" Grid.Column="1" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="LockSyncToggle" x:Uid="LockSyncToggle" Grid.Column="2" AutomationProperties.Name="一起锁定" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="ClipboardHeader" Text="剪贴板" />
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="ClipboardTitle" Text="同步剪贴板和文件" />
                            <TextBlock Style="{StaticResource RowDescriptionStyle}" x:Uid="ClipboardDescription" Text="控制权移到另一台设备时，剪贴板跟着过去：文字、网页格式、图片（最大 8 MB）和复制的文件。收到的文件放在“下载\Rinflow”，超过 512 MB 会先询问。密码管理器标记为隐私的内容不会同步。" />
                        </StackPanel>
                        <TextBlock x:Name="ClipboardState" Grid.Column="1" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="ClipboardToggle" Grid.Column="2" x:Uid="ClipboardToggle" AutomationProperties.Name="同步剪贴板和文件" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="NetworkHeader" Text="网络与安全" />
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="PortTitle" Text="端口" />
                            <TextBlock x:Name="PortHint" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                        <NumberBox
                            x:Name="PortBox"
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            x:Uid="PortBox" AutomationProperties.Name="端口"
                            Maximum="65535"
                            Minimum="1024"
                            SpinButtonPlacementMode="Hidden"
                            ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="TlsTitle" Text="加密传输 (TLS)" />
                            <TextBlock x:Name="TlsDescription" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                        <!-- Always on when available: not something to turn off. -->
                        <TextBlock x:Name="TlsState" Grid.Column="1" Foreground="{ThemeResource TextFillColorDisabledBrush}" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="TlsToggle" Grid.Column="2" x:Uid="TlsToggle" AutomationProperties.Name="加密传输" IsEnabled="False" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="PairedOnlyTitle" Text="仅允许已配对设备" />
                            <TextBlock Style="{StaticResource RowDescriptionStyle}" x:Uid="PairedOnlyDescription" Text="新设备第一次连接时，两台设备会显示同一个 6 位验证码，双方确认后才能互相控制。" />
                        </StackPanel>
                        <TextBlock x:Name="PairedOnlyState" Grid.Column="1" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="PairedOnlyToggle" Grid.Column="2" x:Uid="PairedOnlyToggle" AutomationProperties.Name="仅允许已配对设备" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="ElevatedTitle" Text="被控时可操作管理员窗口、UAC 和锁屏" />
                            <TextBlock x:Name="ElevatedInputDescription" Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="ElevatedInputState" Grid.Column="1" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="ElevatedInputToggle" Grid.Column="2" x:Uid="ElevatedInputToggle" AutomationProperties.Name="被控时可操作管理员窗口、UAC 和锁屏" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" x:Uid="FingerprintTitle" Text="本机指纹" />
                            <TextBlock Style="{StaticResource RowDescriptionStyle}" x:Uid="FingerprintDescription" Text="本机证书的 SHA-256 指纹，其他设备靠它认出这台电脑。" />
                        </StackPanel>
                        <TextBlock
                            x:Name="DeviceIdText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True" />
                        <Button
                            x:Name="CopyIdButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            x:Uid="CopyIdButton" AutomationProperties.Name="复制本机指纹"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            ToolTipService.ToolTip="复制">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        </Button>
                    </Grid>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" x:Uid="AboutHeader" Text="关于" />
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="Rinflow" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource RowDescriptionStyle}" />
                            <!-- The update the agent found (snapshot update): checking, downloading, ready, why it failed. -->
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowDescriptionStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                            <HyperlinkButton x:Name="UpdateNotesLink" x:Uid="UpdateNotesLink" Padding="0" Content="更新内容" Visibility="Collapsed" />
                        </StackPanel>
                        <!-- 检查更新, or 安装并重启 once an update is ready. -->
                        <Button
                            x:Name="CheckUpdateButton"
                            x:Uid="CheckUpdateButton"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="检查更新" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="AutoUpdateTitle" Style="{StaticResource RowTitleStyle}" Text="自动检查更新" />
                            <TextBlock x:Uid="AutoUpdateDescription" Style="{StaticResource RowDescriptionStyle}" Text="每天检查一次新版本，并在后台下载。安装前会先询问。" />
                        </StackPanel>
                        <TextBlock x:Name="AutoUpdateState" Grid.Column="1" Style="{StaticResource SwitchStateStyle}" />
                        <ToggleSwitch x:Name="AutoUpdateToggle" x:Uid="AutoUpdateToggle" Grid.Column="2" AutomationProperties.Name="自动检查更新" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="LogsTitle" Style="{StaticResource RowTitleStyle}" Text="诊断日志" />
                            <TextBlock x:Uid="LogsDescription" Style="{StaticResource RowDescriptionStyle}" Text="记录连接、配对和文件传输的情况，不含剪贴板和键入的内容。反馈问题时附上会很有帮助。" />
                        </StackPanel>
                        <Button
                            x:Name="OpenLogsButton"
                            x:Uid="OpenLogsButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="打开日志文件夹" />
                    </Grid>
                </StackPanel>
            </ScrollView>

            <!-- ================= Edge animation (development builds) ================= -->
            <ScrollView
                x:Name="EffectPage"
                Grid.Row="1"
                ContentOrientation="Vertical"
                Visibility="Collapsed">
                <StackPanel MaxWidth="1040" Padding="28,8,28,24" Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="动画效果" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="仅开发版提供，用来调校屏幕边缘的推动动画；正式版会移除。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Style="{StaticResource CardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="效果演示" />
                            <TextBlock
                                Style="{StaticResource RowDescriptionStyle}"
                                Text="开启后，把鼠标推向放置了设备的那段屏幕边缘（还没有放置设备时用右边缘）：边缘会鼓起，推够距离后光标从对边出现，就像进入了那台设备；再往回推即可回来。关闭本窗口时自动停止。" />
                            <TextBlock
                                x:Name="DemoSideText"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DemoToggle" Grid.Column="1" Style="{StaticResource BareSwitchStyle}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PreviewButton" Content="播放预览" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="ResetEffectButton" Content="恢复默认" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="手感" />
                    <Grid Padding="16" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="推动距离" ToolTipService.ToolTip="第一次穿过边缘前需要推动的鼠标原始计数，越大阻力越强" />
                                <TextBlock x:Name="PushDistanceValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="PushDistanceSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="800" Minimum="40" StepFrequency="10" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="停推后回弹" ToolTipService.ToolTip="停止推动多久后鼓包缩回" />
                                <TextBlock x:Name="ReleaseDelayValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="ReleaseDelaySlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Minimum="0" StepFrequency="0.05" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="连续切换免阻力" ToolTipService.ToolTip="穿过一次后，这段时间内再次穿过不需要推" />
                                <TextBlock x:Name="WarmSecondsValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="WarmSecondsSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="60" Minimum="0" StepFrequency="1" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="角落死区" ToolTipService.ToolTip="“屏幕角落不触发切换”打开时，角落附近这么大的范围不触发" />
                                <TextBlock x:Name="CornerDeadZoneValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="CornerDeadZoneSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="200" Minimum="0" StepFrequency="4" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="动画" />
                    <Grid Padding="16" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="弹簧响应" ToolTipService.ToolTip="动画到位所需的大致时间，越小越干脆" />
                                <TextBlock x:Name="SpringResponseValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="SpringResponseSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="0.8" Minimum="0.1" StepFrequency="0.01" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="阻尼比" ToolTipService.ToolTip="1 为不回弹，越小回弹晃动越明显" />
                                <TextBlock x:Name="SpringDampingValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="SpringDampingSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Minimum="0.3" StepFrequency="0.01" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="外观" />
                    <Grid Padding="16" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="鼓包高度" />
                                <TextBlock x:Name="BumpDepthValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="BumpDepthSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="60" Minimum="8" StepFrequency="1" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="鼓包宽度" />
                                <TextBlock x:Name="BumpWidthValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="BumpWidthSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="160" Minimum="30" StepFrequency="2" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="光点大小" />
                                <TextBlock x:Name="DotSizeValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="DotSizeSlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="40" Minimum="0" StepFrequency="1" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="不透明度" />
                                <TextBlock x:Name="OpacityValue" Grid.Column="1" Style="{StaticResource SliderValueStyle}" />
                                <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Minimum="0.3" StepFrequency="0.01" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="穿过时的涟漪" />
                                <ToggleSwitch x:Name="RippleToggle" Grid.Column="1" Style="{StaticResource BareSwitchStyle}" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="颜色" />
                                <ComboBox x:Name="EffectThemeCombo" Grid.Column="1" MinWidth="140">
                                    <ComboBoxItem Content="跟随系统" Tag="auto" />
                                    <ComboBoxItem Content="浅色" Tag="light" />
                                    <ComboBoxItem Content="深色" Tag="dark" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollView>
        </Grid>

        <!-- ================= Dialogs ================= -->
        <ContentDialog
            x:Name="AddDeviceDialog"
            Grid.RowSpan="2"
            x:Uid="AddDeviceDialog" CloseButtonText="关闭"
            DefaultButton="Close"
            Title="添加设备">
            <StackPanel MinWidth="420" Spacing="12">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="AddDeviceHint" Text="同一网络中运行 Rinflow 的设备会出现在下面。连接后它会加入“我的设备”，再把它拖到屏幕旁边即可。"
                    TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{x:Bind Nearby}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:PeerItem">
                            <Grid MinHeight="56" Padding="16,8" Style="{StaticResource CardStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="{x:Bind Glyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    x:Uid="NearbyConnect"
                                    VerticalAlignment="Center"
                                    Click="OnConnectDevice"
                                    Content="连接"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Tag="{x:Bind Id}"
                                    Visibility="{x:Bind ConnectVisibility}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind StatusText}"
                                    Visibility="{x:Bind OtherVisibility}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel
                    x:Name="NearbyEmptyPanel"
                    Padding="0,8"
                    Orientation="Horizontal"
                    Spacing="12">
                    <ProgressRing Width="20" Height="20" IsActive="True" />
                    <TextBlock
                        x:Uid="NearbySearching"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="正在查找附近的设备…"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Where multicast does not reach: by address. -->
                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="AddressHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Text="通过地址添加" />
                    <TextBlock
                        x:Uid="AddressHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="找不到设备时（例如在公司或访客网络、不同网段），输入对方的 IP 地址或设备名称。在一台设备上添加即可。"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="AddressBox"
                            x:Uid="AddressBox"
                            AutomationProperties.Name="设备地址"
                            PlaceholderText="例如 192.168.1.20" />
                        <Button
                            x:Name="AddAddressButton"
                            x:Uid="AddAddressButton"
                            Grid.Column="1"
                            Content="添加" />
                    </Grid>
                    <TextBlock
                        x:Name="AddressError"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <StackPanel x:Name="AddressList" Spacing="4" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!-- How this PC's mouse feels on one peer (the agent's peer_input). -->
        <ContentDialog
            x:Name="PeerInputDialog"
            x:Uid="PeerInputDialog"
            Grid.RowSpan="2"
            CloseButtonText="取消"
            DefaultButton="Primary"
            PrimaryButtonText="保存"
            SecondaryButtonText="恢复默认">
            <StackPanel MinWidth="360" Spacing="16">
                <TextBlock
                    x:Uid="PeerInputHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="用这台电脑的鼠标操作该设备时生效。"
                    TextWrapping="Wrap" />
                <StackPanel Spacing="4">
                    <Grid>
                        <TextBlock x:Uid="PointerSpeedLabel" Text="指针速度" />
                        <TextBlock x:Name="PointerSpeedValue" Style="{StaticResource SliderValueStyle}" />
                    </Grid>
                    <Slider
                        x:Name="PointerSpeedSlider"
                        x:Uid="PointerSpeedSlider"
                        AutomationProperties.Name="指针速度"
                        Maximum="4"
                        Minimum="0.25"
                        StepFrequency="0.05" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <Grid>
                        <TextBlock x:Uid="ScrollSpeedLabel" Text="滚动速度" />
                        <TextBlock x:Name="ScrollSpeedValue" Style="{StaticResource SliderValueStyle}" />
                    </Grid>
                    <Slider
                        x:Name="ScrollSpeedSlider"
                        x:Uid="ScrollSpeedSlider"
                        AutomationProperties.Name="滚动速度"
                        Maximum="5"
                        Minimum="0.25"
                        StepFrequency="0.05" />
                </StackPanel>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="InvertScrollLabel" VerticalAlignment="Center" Text="反转滚动方向" />
                    <ToggleSwitch
                        x:Name="InvertScrollToggle"
                        x:Uid="InvertScrollToggle"
                        Grid.Column="1"
                        AutomationProperties.Name="反转滚动方向"
                        Style="{StaticResource BareSwitchStyle}" />
                </Grid>
            </StackPanel>
        </ContentDialog>

        <!-- Pairing: both devices show the same code (from both certificates). -->
        <ContentDialog
            x:Name="PairingDialog"
            Grid.RowSpan="2"
            CloseButtonText="取消"
            DefaultButton="Primary"
            x:Uid="PairingDialog" PrimaryButtonText="配对">
            <StackPanel MinWidth="380" Spacing="20">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="PairingHint" Text="确认对方屏幕显示相同的代码"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="PairingCode"
                    Margin="0,8,0,8"
                    HorizontalAlignment="Center"
                    CharacterSpacing="200"
                    Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock
                    x:Name="PairingStatus"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="HotkeyDialog"
            Grid.RowSpan="2"
            CloseButtonText="取消"
            DefaultButton="Primary"
            PrimaryButtonText="保存"
            SecondaryButtonText="恢复默认"
            x:Uid="HotkeyDialog" Title="锁定快捷键">
            <StackPanel MinWidth="360" Spacing="16">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Uid="HotkeyInstructions" Text="按下新的组合键：Ctrl、Alt 或 Win 中至少一个，再加一个普通按键。"
                    TextWrapping="Wrap" />
                <StackPanel
                    x:Name="HotkeyPreview"
                    MinHeight="36"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6" />
                <TextBlock
                    x:Name="HotkeyHint"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
