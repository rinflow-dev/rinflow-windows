namespace Rinflow
{
    // One device row: in the device list, the add-device dialog and the tray
    // panel. Rows are rebuilt from every agent state snapshot. Colours stay
    // in XAML (ThemeResource), so rows only say which parts show.
    // (MIDL reads this file in the system code page: keep it ASCII.)
    // Latency changes in place (PropertyChanged); everything else replaces
    // the row.
    runtimeclass PeerItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        PeerItem(String id, String name, String detail, String glyph);

        String Id{ get; };
        String Name{ get; };
        String Detail{ get; };
        // Segoe Fluent Icons glyph for the kind of device.
        String Glyph{ get; };

        // "2 ms", an em dash, or empty.
        String Latency{ get; set; };
        // Connected, not connected, offline...
        String StatusText{ get; set; };
        // Connected: the status shows green with a filled dot. Otherwise it
        // shows in the secondary text colour with a hollow dot.
        Boolean IsConnected{ get; set; };
        // Not reachable now: the row is dimmed.
        Boolean IsOffline{ get; set; };
        // Online but not connected: offer to connect instead of a latency.
        Boolean CanConnect{ get; set; };

        Microsoft.UI.Xaml.Visibility ConnectedVisibility{ get; };
        Microsoft.UI.Xaml.Visibility OtherVisibility{ get; };
        Microsoft.UI.Xaml.Visibility LatencyVisibility{ get; };
        Microsoft.UI.Xaml.Visibility ConnectVisibility{ get; };
        Double ContentOpacity{ get; };
    }
}
