<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rinflow.TrayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rinflow"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Rinflow">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        VerticalAlignment="Top"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="12,12,12,8" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Width="20" Height="20" VerticalAlignment="Center" Stretch="Uniform" Source="{ThemeResource AppLogo}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Rinflow" />
            </StackPanel>

            <Grid MinHeight="48" Padding="12,0" ColumnSpacing="12" Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE72E;" />
                <TextBlock Grid.Column="1" Style="{StaticResource RowTitleStyle}" x:Uid="TrayLockTitle" Text="锁定在这台电脑" />
                <ToggleSwitch
                    x:Name="LockToggle"
                    Grid.Column="2"
                    x:Uid="TrayLockToggle" AutomationProperties.Name="锁定在这台电脑"
                    Style="{StaticResource BareSwitchStyle}" />
            </Grid>

            <!-- Only while another device drives this PC: which one. -->
            <StackPanel x:Name="ControlledPanel" Spacing="8" Visibility="Collapsed">
                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="4,0,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    x:Uid="TrayControlledHeader" Text="正在控制这台电脑" />
                <ItemsControl Margin="0,-4,0,0" ItemsSource="{x:Bind Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:PeerItem">
                            <Grid Padding="4,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Latency}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <Grid
            Grid.Row="1"
            Height="44"
            Padding="8,0,6,0"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <HyperlinkButton
                x:Name="OpenButton"
                VerticalAlignment="Center"
                x:Uid="TrayOpenButton" Content="打开主窗口" />
            <Button
                x:Name="SettingsButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                x:Uid="TraySettingsButton" AutomationProperties.Name="设置"
                Style="{StaticResource SubtleIconButtonStyle}"
                ToolTipService.ToolTip="设置">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
            <Button
                x:Name="QuitButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                x:Uid="TrayQuitButton" AutomationProperties.Name="退出 Rinflow"
                Style="{StaticResource SubtleIconButtonStyle}"
                ToolTipService.ToolTip="退出 Rinflow">
                <FontIcon FontSize="16" Glyph="&#xE7E8;" />
            </Button>
        </Grid>
    </Grid>
</Window>
