<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LinkCursor.TrayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkCursor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LinkCursor">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        VerticalAlignment="Top"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="16,16,16,12" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Width="24" Height="24" VerticalAlignment="Center" Stretch="Uniform" Source="{ThemeResource AppLogo}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="LinkCursor" />
            </StackPanel>

            <Grid MinHeight="56" Padding="16,0" Style="{StaticResource CardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE962;" />
                <TextBlock Grid.Column="1" Style="{StaticResource RowTitleStyle}" x:Uid="TraySharingTitle" Text="键鼠共享" />
                <ToggleSwitch
                    x:Name="SharingToggle"
                    Grid.Column="2"
                    x:Uid="TraySharingToggle" AutomationProperties.Name="键鼠共享"
                    Style="{StaticResource BareSwitchStyle}" />
            </Grid>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock
                Margin="4,0,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                x:Uid="TrayDevicesHeader" Text="设备" />
            <ItemsControl Margin="0,-6,0,0" ItemsSource="{x:Bind Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PeerItem">
                        <Grid Padding="4,9" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="18"
                                Glyph="{x:Bind Glyph}"
                                Opacity="{x:Bind ContentOpacity}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Opacity="{x:Bind ContentOpacity}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <Ellipse
                                Grid.Column="2"
                                Width="8"
                                Height="8"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind ConnectedVisibility}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind StatusText}"
                                Visibility="{x:Bind OtherVisibility}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid
            Grid.Row="1"
            Height="56"
            Padding="12,0,10,0"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <HyperlinkButton
                x:Name="OpenButton"
                VerticalAlignment="Center"
                x:Uid="TrayOpenButton" Content="打开主窗口" />
            <Button
                x:Name="SettingsButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                x:Uid="TraySettingsButton" AutomationProperties.Name="设置"
                Style="{StaticResource SubtleIconButtonStyle}"
                ToolTipService.ToolTip="设置">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
            <Button
                x:Name="QuitButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                x:Uid="TrayQuitButton" AutomationProperties.Name="退出 LinkCursor"
                Style="{StaticResource SubtleIconButtonStyle}"
                ToolTipService.ToolTip="退出 LinkCursor">
                <FontIcon FontSize="16" Glyph="&#xE7E8;" />
            </Button>
        </Grid>
    </Grid>
</Window>
